# Sanity — create a free project at https://sanity.io/manage
# These are PUBLIC (safe to expose to the browser).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only read token (optional — only needed for draft/preview or private datasets).
# Create at: sanity.io/manage → API → Tokens (Viewer role).
SANITY_API_READ_TOKEN=

# Shared secret for the on-demand revalidation webhook.
# Set the same value in the Sanity webhook config (sanity.io/manage → API → Webhooks).
SANITY_REVALIDATE_SECRET=
